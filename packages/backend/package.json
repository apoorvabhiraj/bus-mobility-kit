{
    "name":  "@delhi-transport/backend",
    "version":  "1.0.0",
    "description":  "Backend API for Intelligent Bus Mobility \u0026 Crowdedness-Aware Journey Planner",
    "main":  "dist/index.js",
    "scripts":  {
                    "build":  "tsc",
                    "dev":  "ts-node-dev --respawn --transpile-only src/index.ts",
                    "start":  "node dist/index.js",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "typecheck":  "tsc --noEmit",
                    "prisma:generate":  "prisma generate",
                    "prisma:push":  "prisma db push",
                    "lint":  "tsc --noEmit"
                },
    "dependencies":  {
                         "@prisma/client":  "^5.22.0",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "morgan":  "^1.10.0",
                         "zod":  "^3.24.2"
                     },
    "devDependencies":  {
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^4.17.21",
                            "@types/morgan":  "^1.9.9",
                            "@types/node":  "^22.13.0",
                            "@types/supertest":  "^6.0.2",
                            "prisma":  "^5.22.0",
                            "supertest":  "^7.0.0",
                            "ts-node-dev":  "^2.0.0",
                            "typescript":  "^5.7.3",
                            "vitest":  "^2.1.8"
                        }
}