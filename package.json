{
    "name":  "delhi-transport-stack",
    "version":  "1.0.0",
    "private":  true,
    "description":  "Intelligent Bus Mobility \u0026 Crowdedness-Aware Journey Planner (Delhi)",
    "scripts":  {
                    "build":  "pnpm --filter \"./packages/*\" build",
                    "dev":  "pnpm --filter \"./packages/*\" --parallel dev",
                    "start":  "pnpm --filter @delhi-transport/backend start",
                    "test":  "pnpm --filter \"./packages/*\" test",
                    "typecheck":  "pnpm --filter \"./packages/*\" typecheck",
                    "contract:check":  "node scripts/check-openapi-compatibility.js",
                    "prisma:generate":  "pnpm --filter @delhi-transport/backend prisma:generate",
                    "dev:backend":  "pnpm --filter @delhi-transport/backend dev",
                    "dev:frontend":  "pnpm --filter delhi-journey-planner-frontend dev",
                    "lint":  "pnpm --filter \"./packages/*\" lint"
                },
    "devDependencies":  {
                            "yaml":  "^2.6.1"
                        },
    "pnpm":  {
                 "onlyBuiltDependencies":  [
                                               "@prisma/client",
                                               "@prisma/engines",
                                               "esbuild",
                                               "prisma"
                                           ]
             }
}